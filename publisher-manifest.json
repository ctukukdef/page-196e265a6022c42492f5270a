: 500;cursor: pointer;outline: none;list-style: none;display: flex;justify-content: space-between;align-items: center}\nsummary::-webkit-details-marker {display: none}\nsummary::after {content: \"+\";font-family: monospace;font-size: 1.2rem;color: var(--mint)}\ndetails[open] summary::after {content: \"—\"}\ndetails p {margin-top: 1rem;font-size: 0.9rem;color: var(--text-muted);line-height: 1.7}\nfooter {max-width: 1200px;margin: 0 auto;padding: 4rem 2rem;display: flex;justify-content: space-between;align-items: center;font-size: 0.85rem;color: var(--text-muted)}\nfooter a {color: var(--text-muted);text-decoration: none}\nfooter a:hover {color: var(--mint)}\n@media (max-width: 768px) {\n  .hero {grid-template-columns: 1fr;gap: 2rem;min-height: auto}\n  .hero-content h1 {font-size: 2.5rem}\n  .spec-grid {grid-template-columns: 1fr;gap: 2rem}\n  .plan-features {grid-template-columns: 1fr}\n  .nav-links {display: none}\n}\n</style><header>\n  <div class=\"nav-container\">\n    <a href=\"#\" class=\"brand-logo\">MONEYCOME</a>\n    <ul class=\"nav-links\">\n      <li><a href=\"#overview\">系统概览</a></li>\n      <li><a href=\"#plans\">服务层级</a></li>\n      <li><a href=\"#specs\">技术规格</a></li>\n      <li><a href=\"#faq\">常见问题</a></li>\n    </ul>\n  </div>\n</header>\n\n<main>\n  <div class=\"hero\" id=\"overview\">\n    <div class=\"hero-content\">\n      <h1>moneycome · 理性管理 <span>数字资产</span> 的架构终端</h1>\n      <p>moneycome 提供高精度的财务数据归集与分配方案。无冗余交互，以严谨逻辑与冷峻美学构建您的长效资产通道。</p>\n      <a href=\"#plans\" class=\"action-btn\">查看配置方案</a>\n    </div>\n    <div class=\"hero-panel\">\n      <h3>系统实时状态</h3>\n      <div class=\"metric-row\">\n        <span>节点吞吐效率</span>\n        <span>99.98%</span>\n      </div>\n      <div class=\"metric-row\">\n        <span>协议响应延迟</span>\n        <span>14ms</span>\n      </div>\n      <div class=\"metric-row\">\n        <span>核心路由加密</span>\n        <span>AES-256-GCM</span>\n      </div>\n      <div class=\"metric-row\">\n        <span>当前终端在线</span>\n        <span>稳定运行</span>\n      </div>\n    </div>\n  </div>\n\n  <section id=\"plans\">\n    <h2>服务层级配置</h2>\n    <p class=\"section-intro\">根据数据规模与团队吞吐需求，选择对应的规格参数。所有层级均享有基础加密与高可用保障。</p>\n    \n    <div class=\"plans-stack\">\n      <div class=\"plan-card\">\n        <div class=\"plan-header\">\n          <span class=\"plan-title\">基础版</span>\n          <span class=\"plan-price\">¥15 / 月</span>\n        </div>\n        <ul class=\"plan-features\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <a href=\"#\" class=\"action-btn\">选择基础版</a>\n      </div>\n\n      <div class=\"plan-card featured\">\n        <div class=\"plan-header\">\n          <span class=\"plan-title\">旗舰版</span>\n          <span class=\"plan-price\">¥35 / 月</span>\n        </div>\n        <ul class=\"plan-features\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n        <a href=\"#\" class=\"action-btn\">选择旗舰版</a>\n      </div>\n\n      <div class=\"plan-card\">\n        <div class=\"plan-header\">\n          <span class=\"plan-title\">团队版</span>\n          <span class=\"plan-price\">¥85 / 月</span>\n        </div>\n        <ul class=\"plan-features\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <a href=\"#\" class=\"action-btn\">选择团队版</a>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"specs\">\n    <h2>技术规格与说明</h2>\n    <p class=\"section-intro\">moneycome 遵循极简主义工程学，确保每一项功能均有据可循，无多余后台驻留。</p>\n    \n    <div class=\"spec-grid\">\n      <div class=\"spec-item\">\n        <h3>零日志审计</h3>\n        <p>系统不记录任何源 IP、访问目标及传输内容。所有状态数据均在内存中处理，保障完全的隐私归属。</p>\n      </div>\n      <div class=\"spec-item\">\n        <h3>多端协同支持</h3>\n        <p>全面兼容主流桌面及移动操作系统。原生客户端经深度优化，CPU 占用率维持在极低水平。</p>\n      </div>\n      <div class=\"spec-item\">\n        <h3>智能分流策略</h3>\n        <p>内置精准的路由规则库，国内外流量无感切换，确保核心业务带宽不受本地网络干扰。</p>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <h2>常见问题解答</h2>\n    <p class=\"section-intro\">关于账户配置、计费周期以及使用规范的说明。</p>\n    \n    <div class=\"faq-container\">\n      <details>\n        <summary>如何更改当前的订阅配置？</summary>\n        <p>您可随时在后台控制面板执行升级或降级操作。系统将自动按剩余有效天数计算差价，实时完成配置变更，无需人工干预。</p>\n      </details>\n      <details>\n        <summary>流量额度是否支持跨月累加？</summary>\n        <p>不支持。每个计费周期的起始日会自动重置当月可用流量配额，未用尽的额度不会结转至下一个周期。</p>\n      </details>\n      <details>\n        <summary>是否支持退款政策？</summary>\n        <p>鉴于数字服务的特殊性，服务开通后在规定试用期内支持无条件按比例退款。具体条款可参阅用户协议细则。</p>\n      </details>\n      <details>\n        <summary>连接出现延迟波动时应如何处理？</summary>\n        <p>建议通过控制面板的测速功能重新校准最优节点，或切换至专线优化节点池。如问题持续，可提交工单由技术团队协助排查。</p>\n      </details>\n    </div>\n  </section>\n</main>\n\n<footer>\n  <div>© moneycome. All rights reserved.</div>\n  <div>\n    <a href=\"#overview\">返回顶部</a>\n  </div>\n</footer>",
